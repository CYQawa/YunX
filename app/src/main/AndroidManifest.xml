<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 实时更新（OPPO ColorOS 16 流体云按此规范接入）：把下载进度提升为「进行中」通知 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 下载调试：读取当前网络类型 / 是否计费 / 链路速率估计（普通权限，安装即授予，无运行时弹窗；
         蜂窝代际 5G/4G 与真正的信号强度还需要 READ_PHONE_STATE / ACCESS_WIFI_STATE 等权限，
         本项目不申请，日志里只记「未区分」，改用系统给的链路速率估计当网络质量指标） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 锁屏保持下载：息屏时维持 Wi-Fi/CPU，避免长时间下载断连 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 锁屏保持下载：允许引导用户将应用加入「忽略电池优化」白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- APK 安装：Android 8+ 检查「安装未知来源应用」权限需要 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 9- 写公共 Download 目录需要（10 走 MediaStore，legacy 模式回退也需要） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- 内置下载引擎（Gopeed）只能按真实文件系统路径写文件：Android 11+ 要写公共 Download 目录
         就得有「所有文件访问」。低版本不需要（9- 用上面的 WRITE_EXTERNAL_STORAGE，
         10 由 application 的 requestLegacyExternalStorage 回到旧模式 + 同一运行时权限）。
         用户需在系统设置里手动开启，PermissionState.allFilesAccessGranted 判断，
         不给也能用——引擎会自动退到应用外部私有目录（见 Agent.md §3.29）。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".YunXApp"
        android:allowBackup="false"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.ComposeEmptyActivity">

        <!-- ★ launchMode=singleTask：深链接（分享链接一键唤起）必须复用同一个实例，
             否则从浏览器点链接会再起一个 MainActivity（两个任务两套状态）。
             深链接 intent 由 onNewIntent 送达（见 MainActivity.handleDeepLink）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ComposeEmptyActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============================ 深链接（按平台注册，可在设置里逐个关掉） ============================
             为什么要用 activity-alias 而不是直接写在 MainActivity 上：清单里的 intent-filter 无法在运行时修改，
             要让用户能在设置里改「哪些链接由云析接管」，只能把每种链接挂到独立的 alias 上，
             再用 PackageManager.setComponentEnabledSetting 启停（与桌面动态图标同一套机制，见 ThemeScreen）。
             ★ 这些 alias 的类名必须与 data/prefs/LinkOpenTarget.kt 里的 alias 常量逐字一致。
             ★ 一律不开 autoVerify：pan.quark.cn / pan.baidu.com 这些域名不是我们的，放不了 assetlinks.json，
               校验失败反而会被系统排除掉；不开校验就是普通深链接——首次点链接弹「打开方式」，选云析后可设默认。
             ★ 只注册 ShareLinkParser 真正认得的 URL 形态（路径前缀与解析正则对齐），避免抢走处理不了的链接。 -->

        <!-- 夸克网盘：pan.quark.cn/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.QuarkLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.quark.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- UC 网盘：drive.uc.cn/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.UcLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="drive.uc.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 迅雷网盘：pan.xunlei.com/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.XunleiLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.xunlei.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 百度网盘：pan.baidu.com/s/1xxx -->
        <activity-alias
            android:name="com.yunx.app.link.BaiduLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.baidu.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 139（和彩云）：yun.139.com/shareweb/.../w/i/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.C139Link"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="yun.139.com" android:pathPrefix="/shareweb/" />
            </intent-filter>
        </activity-alias>

        <!-- 123 云盘：www.123pan.com/s/xxx、www.123865.com/s/xxx、www.123pan.cn/s/xxx、<UID>.share.123pan.cn/123pan/xxx
             四种形态路径规则不同，必须一个 <data> 一条 intent-filter —— 同一 filter 内的多条 <data> 会被
             并成「scheme/host/path 三个集合求交」，路径会串到别的 host 上。 -->
        <activity-alias
            android:name="com.yunx.app.link.Pan123Link"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123pan.com" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123865.com" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123pan.cn" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="share.123pan.cn" android:pathPrefix="/123pan/" />
                <data android:scheme="https" android:host="*.share.123pan.cn" android:pathPrefix="/123pan/" />
            </intent-filter>
        </activity-alias>

        <!-- 115 网盘：115.com/s/<code>、以及口令形态 115.com/<code>-<提取码>/（code 以 sw 开头） -->
        <activity-alias
            android:name="com.yunx.app.link.Pan115Link"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="115.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="115cdn.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="115rc.com" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- 口令形态：路径以 /sw 开头（分隔符用 pathPrefix 而不是 pathPattern：
                     pathPattern 是 SIMPLE_GLOB，`*` 表示「重复前一个字符」而不是任意串，/sw* 匹配不到 /sws8xxx） -->
                <data android:scheme="https" android:host="115.com" android:pathPrefix="/sw" />
                <data android:scheme="https" android:host="115cdn.com" android:pathPrefix="/sw" />
                <data android:scheme="https" android:host="115rc.com" android:pathPrefix="/sw" />
            </intent-filter>
        </activity-alias>

        <!-- 光鸭云盘：www.guangyapan.com/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.GuangyaLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.guangyapan.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 蓝奏云：域名族 lanzou* 的 a-z 轮换域名 + lanzn.com（2026-10 起的新族，issue #197）。
             bare 与 *. 两种写法都要列，清单通配符只能匹配最左一级。
             蓝奏云优享版：ilanzou.com/net/org/cn/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.LanzouLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="lanzou.com" />
                <data android:scheme="https" android:host="*.lanzou.com" />
                <data android:scheme="https" android:host="lanzoua.com" />
                <data android:scheme="https" android:host="*.lanzoua.com" />
                <data android:scheme="https" android:host="lanzoub.com" />
                <data android:scheme="https" android:host="*.lanzoub.com" />
                <data android:scheme="https" android:host="lanzouc.com" />
                <data android:scheme="https" android:host="*.lanzouc.com" />
                <data android:scheme="https" android:host="lanzoud.com" />
                <data android:scheme="https" android:host="*.lanzoud.com" />
                <data android:scheme="https" android:host="lanzoue.com" />
                <data android:scheme="https" android:host="*.lanzoue.com" />
                <data android:scheme="https" android:host="lanzouf.com" />
                <data android:scheme="https" android:host="*.lanzouf.com" />
                <data android:scheme="https" android:host="lanzoug.com" />
                <data android:scheme="https" android:host="*.lanzoug.com" />
                <data android:scheme="https" android:host="lanzouh.com" />
                <data android:scheme="https" android:host="*.lanzouh.com" />
                <data android:scheme="https" android:host="lanzoui.com" />
                <data android:scheme="https" android:host="*.lanzoui.com" />
                <data android:scheme="https" android:host="lanzouj.com" />
                <data android:scheme="https" android:host="*.lanzouj.com" />
                <data android:scheme="https" android:host="lanzouk.com" />
                <data android:scheme="https" android:host="*.lanzouk.com" />
                <data android:scheme="https" android:host="lanzoul.com" />
                <data android:scheme="https" android:host="*.lanzoul.com" />
                <data android:scheme="https" android:host="lanzoum.com" />
                <data android:scheme="https" android:host="*.lanzoum.com" />
                <data android:scheme="https" android:host="lanzoun.com" />
                <data android:scheme="https" android:host="*.lanzoun.com" />
                <data android:scheme="https" android:host="lanzouo.com" />
                <data android:scheme="https" android:host="*.lanzouo.com" />
                <data android:scheme="https" android:host="lanzoup.com" />
                <data android:scheme="https" android:host="*.lanzoup.com" />
                <data android:scheme="https" android:host="lanzouq.com" />
                <data android:scheme="https" android:host="*.lanzouq.com" />
                <data android:scheme="https" android:host="lanzour.com" />
                <data android:scheme="https" android:host="*.lanzour.com" />
                <data android:scheme="https" android:host="lanzous.com" />
                <data android:scheme="https" android:host="*.lanzous.com" />
                <data android:scheme="https" android:host="lanzout.com" />
                <data android:scheme="https" android:host="*.lanzout.com" />
                <data android:scheme="https" android:host="lanzouu.com" />
                <data android:scheme="https" android:host="*.lanzouu.com" />
                <data android:scheme="https" android:host="lanzouv.com" />
                <data android:scheme="https" android:host="*.lanzouv.com" />
                <data android:scheme="https" android:host="lanzouw.com" />
                <data android:scheme="https" android:host="*.lanzouw.com" />
                <data android:scheme="https" android:host="lanzoux.com" />
                <data android:scheme="https" android:host="*.lanzoux.com" />
                <data android:scheme="https" android:host="lanzouy.com" />
                <data android:scheme="https" android:host="*.lanzouy.com" />
                <data android:scheme="https" android:host="lanzouz.com" />
                <data android:scheme="https" android:host="*.lanzouz.com" />
                <!-- 新域名族 lanzn（issue #197：https://<用户子域>.lanzn.com/<shareId>）：
                     ShareLinkParser 已认（见 lanzouShareIdRegex），这里不列就只有「粘贴能解析、点链接却打不开」 -->
                <data android:scheme="https" android:host="lanzn.com" />
                <data android:scheme="https" android:host="*.lanzn.com" />
                <data android:scheme="https" android:host="ilanzou.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="ilanzou.net" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="ilanzou.org" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="ilanzou.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 磁力链接：magnet:?xt=urn:btih:...（只有 Gopeed 引擎能下，进下载页的「添加下载任务」弹窗预填） -->
        <activity-alias
            android:name="com.yunx.app.link.MagnetLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
        </activity-alias>

        <!-- 自有协议：yunx://resolve?url=<encode 后的分享链接>&pwd=xxxx
             用于其它 App/网页/二维码精确拉起（不受上面域名白名单限制，也是蓝奏云那些列不全的域名的兜底） -->
        <activity-alias
            android:name="com.yunx.app.link.YunxLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yunx" />
            </intent-filter>
        </activity-alias>

        <!-- 分享到云析：在别的 App 里「分享 → 云析」（文本 / 口令 / 分享链接都收） -->
        <activity-alias
            android:name="com.yunx.app.link.ShareLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- 选中文本解析：长按选中一段文字后，系统文本选择菜单（三点 → 更多）里出现「用云析解析」。
             这是安卓官方的「把选中文本交给第三方 App 处理」入口（PROCESS_TEXT），不需要 ROM 白名单，
             也是系统侧那些「复制口令后推荐打开某 App」能力在标准安卓上唯一可由第三方占据的位置。
             label 单独用一个字符串：菜单里显示成「用云析解析」比光秃秃一个「云析」清楚。 -->
        <activity-alias
            android:name="com.yunx.app.link.ProcessTextLink"
            android:exported="true"
            android:label="@string/process_text_action"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标动态切换（新图标）：默认禁用，主题与外观页切换后经 setComponentEnabledSetting 启用。
             图标走 @drawable/ic_launcher_new：API 26+ 为自适应图标（drawable-v26），API 24-25 为位图回退。
             roundIcon 必须一并声明：部分启动器优先取 roundIcon，缺省会回落到 application 的经典图标。 -->
        <activity-alias
            android:name=".MainActivityIcon2"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_new"
            android:roundIcon="@drawable/ic_launcher_new"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 崩溃界面：独立进程运行，避免主线程崩溃后无法展示 UI -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.ComposeEmptyActivity" />

        <!-- 下载前台服务：下载中保持前台，避免后台限速/进程被杀 -->
        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 文件共享：导出日志等场景（ACTION_SEND 分享） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".LaunchGate"
            android:authorities="${applicationId}.launchgate"
            android:exported="false" />

    </application>

</manifest>
