    <!-- About -->
    <string name="vm_about_title">About YunX</string>
    <string name="vm_about_intro_title">About the app</string>
    <string name="vm_about_intro_desc">YunX is a tool for parsing drive / video share links and downloading them at high speed. Paste a link: drive shares can be browsed and downloaded fast; video links are resolved into direct links and original images; images / videos / audio can all be previewed and played online.</string>
    <string name="vm_about_license">This project is open source under GNU AGPL-3.0</string>
    <string name="vm_about_version_footer">YunX v%1$s · Made with ❤ and deepseek</string>
