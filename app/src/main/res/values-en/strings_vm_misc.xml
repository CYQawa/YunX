    <!-- GitHub Token -->
    <string name="vm_github_token_usage">The Token only raises the API limit (60/hour anonymous, 5000/hour authenticated). It is encrypted and stored using Android Keystore AES-GCM.</string>
    <string name="vm_github_token_howto_title">How to get a Token:</string>
    <string name="vm_github_token_howto_body">1. Open GitHub in a desktop browser, click your avatar in the top right → Settings\n2. On the left, Developer settings → Personal access tokens → Tokens (classic) → Generate new token\n3. Check public_repo to browse public repositories; to see your own private repositories on the home page, also check repo\n4. A validity of 90 days or No expiration is recommended; after generating, copy and paste it into the field above</string>
    <string name="vm_github_no_browser_link_copied">No available browser found. Link copied.</string>
    <string name="vm_github_get_token">↗ Get a Token from GitHub</string>
    <string name="vm_github_token_security_tip">Security tip: grant only the minimum permissions and do not check delete/manage permissions. The Token is never stored in plain text or uploaded; to remove it, just clear the field and save.</string>
