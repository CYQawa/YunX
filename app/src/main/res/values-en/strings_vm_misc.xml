    <string name="vm_about_drives">Drives</string>
    <string name="vm_about_video_parsing">Video parsing</string>
    <string name="vm_about_feature_netdisk_title">Drive share parsing</string>
    <string name="vm_about_feature_netdisk_desc">Direct link detection for Quark / UC / Xunlei / Baidu / 139 / 123 / 115 / Guangya / Lanzou / Lanzou Premium</string>
    <string name="vm_about_feature_video_title">Video link parsing</string>
    <string name="vm_about_feature_video_desc">Douyin / Xiaohongshu / Kuaishou / Weibo / AcFun work without login; Bilibili offers higher quality after login; Pixiv only resolves some public works without login, paste your browser cookie to resolve all works</string>
    <string name="vm_about_feature_preview_title">Online preview &amp; playback</string>
    <string name="vm_about_feature_preview_desc">View images / videos / audio online (request headers added automatically); text files in drives can also be opened</string>
    <string name="vm_about_feature_mux_title">Audio/video muxing</string>
    <string name="vm_about_feature_mux_desc">Bilibili HD comes as separate audio and video tracks; the app muxes them internally, no extra ffmpeg needed</string>
    <string name="vm_about_feature_download_title">High-speed chunked downloads</string>
    <string name="vm_about_feature_download_desc">Multi-threaded concurrency + resumable downloads make full use of your bandwidth</string>
