<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ComposeEmptyActivity" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- 显式浅色窗口主题：应用内「始终浅色」时 MainActivity 动态 setTheme 使用（不受系统深色影响） -->
    <style name="Theme.ComposeEmptyActivity.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- 显式深色窗口主题：应用内「始终深色」时 MainActivity 动态 setTheme 使用（系统为浅色时也能深色开屏） -->
    <style name="Theme.ComposeEmptyActivity.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/background_dark</item>
    </style>
</resources>